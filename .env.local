# Live Polygon mainnet deployment (github.com/bird238/blockchess). Nothing secret here; keep
# API-key RPC URLs and DATABASE_URL in the host's own copy, not in git. See README.md.

CHAIN_ID=137
# Comma-separated; Ponder load-balances and routes around failing endpoints. Tenderly's public
# gateway serves wide eth_getLogs ranges; publicnode caps ranges at 10000 blocks and is often
# overloaded, so it is listed second. Add keyed endpoints (Alchemy/dRPC/...) if you have them.
# (PONDER_RPC_URL_POLYGON, a single URL, is still accepted.)
PONDER_RPC_URLS=https://gateway.tenderly.co/public/polygon,https://polygon-bor-rpc.publicnode.com
# Optional cap on eth_getLogs block ranges (Ponder adapts automatically if unset).
ETH_GETLOGS_BLOCK_RANGE=50000

FACTORY_ADDRESS=0x532408070454D13ED7Ef142fb0Fb86247ea3d7E0
ELO_REGISTRY_ADDRESS=0xFf8AC12617793a41a9Bf392971300F5cbE41e534
# Factory deployment block (tx 0xf1bf37ac...a907). Never move it forward: the indexer needs no
# historical state, so the full history is always indexable.
START_BLOCK=93290639

# Production storage: PostgreSQL. Without DATABASE_URL Ponder uses embedded PGlite (dev only).
# DATABASE_URL=postgresql://blockchess:CHANGE_ME@127.0.0.1:5432/blockchess
PONDER_SCHEMA=blockchess_v2
